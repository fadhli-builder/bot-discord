# ===== WAJIB =====
# Token bot dari Discord Developer Portal (tab Bot > Reset Token)
# JANGAN pernah dibagikan / di-commit!
DISCORD_TOKEN=

# Application ID (tab OAuth2 > Client ID)
CLIENT_ID=

# ID server Discord tempat bot dipasang
GUILD_ID=

# ===== CHANNEL =====
# Channel untuk laporan report (khusus mod)
MOD_CHANNEL_ID=

# Channel fallback pengumuman match kalau DM gagal
MATCH_CHANNEL_ID=

# ===== GERBANG UMUR =====
# true  = umur WAJIB, di bawah MIN_AGE ditolak (data tidak disimpan)
# false = umur opsional, bebas daftar
AGE_GATE_ENABLED=false
MIN_AGE=18

# ===== REKAP HARIAN =====
# Crypto (CoinGecko) dan saham: boleh channel yang sama
CRYPTO_CHANNEL_ID=
STOCK_CHANNEL_ID=

# Lowongan kerja harian (09:00 WIB, sumber Kalibrr)
LOKER_CHANNEL_ID=

# Game Roblox trending harian (18:00 WIB)
ROBLOX_CHANNEL_ID=

# Film trending harian (19:00 WIB)
FILM_CHANNEL_ID=

# ===== KONTEN =====
# Kuis kosa kata harian (07:00 WIB)
VOCAB_CHANNEL_ID=

# One Day One Hadith
HADIST_CHANNEL_ID=

# ===== OPSIONAL (khusus testing, biarkan kosong di produksi) =====
# KARAOKE_TEST_SKIP_VC_CHECK=1
# VOCAB_RECAP_FORCE=1